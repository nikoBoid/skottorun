APP_NAME="Scotto Run"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://run.example.com
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=en

PUBLIC_HOST=run.example.com
HTTP_PORT=8088

LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=scottorun
REVERB_APP_KEY=replace-with-a-random-key
REVERB_APP_SECRET=replace-with-a-random-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://run.example.com

MAIL_MAILER=log
FILESYSTEM_DISK=local
